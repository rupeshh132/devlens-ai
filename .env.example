# Environment variables example configuration

# --- Database ---
DB_URL=jdbc:postgresql://postgres:5432/devlens
DB_USER=postgres
DB_PASSWORD=secretpassword
POSTGRES_DB=devlens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword

# --- JWT Configuration ---
# 256-bit secret key (min length)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long

# --- GitHub OAuth Configuration ---
# Generate these in GitHub Developer Settings
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8080/api/v1

# --- External APIs ---
GEMINI_API_KEY=your_gemini_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
DB_USERNAME=postgres
